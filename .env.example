# Copy to .env and fill in your values. Loaded at runtime via os.environ.
# Real env files (.env) are gitignored.

# Project root override. Defaults to the repo directory; only set this when
# the package is installed somewhere other than the source tree.
# TINYLLAMA_PROJECT_ROOT=/path/to/TinyLlama_LoRA_CLI_Copilot

# HuggingFace base model id. Override to evaluate against other small models.
# TINYLLAMA_BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0

# Logging verbosity (DEBUG / INFO / WARNING / ERROR)
# TINYLLAMA_LOG_LEVEL=INFO

# GitHub token (raises rate limit when scraping TLDR pages)
# GITHUB_TOKEN=ghp_xxx

# API keys for LLM-as-judge eval (Phase C2/C3)
# ANTHROPIC_API_KEY=sk-ant-xxx
# OPENAI_API_KEY=sk-xxx
